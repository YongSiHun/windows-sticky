<Window x:Class="StickyNote.Views.NoteManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="720" Height="520" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterScreen" Background="#F7F7F4">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/><Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="SettingsClick" HorizontalAlignment="Right"/></DockPanel>
  <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,16,0,12" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
  <ListBox Grid.Row="2" ItemsSource="{Binding Notes}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" BorderBrush="#DDDDDD">
   <ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,2" Background="{Binding backgroundColor}"><StackPanel>
    <DockPanel><CheckBox IsChecked="{Binding isVisible, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,0,8,0"/><TextBlock Text="{Binding title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></DockPanel>
    <TextBlock Text="{Binding content}" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="22,4,0,0" Foreground="#555555"/>
   </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="NewButton" Click="NewClick"/><Button x:Name="ShowButton" Click="ShowClick"/><Button x:Name="HideButton" Click="HideClick"/><Button x:Name="DeleteButton" Click="DeleteClick"/><Button x:Name="ShowAllButton" Click="ShowAllClick"/><Button x:Name="HideAllButton" Click="HideAllClick"/></WrapPanel>
 </Grid>
</Window>
