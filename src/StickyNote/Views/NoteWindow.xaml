<Window x:Class="StickyNote.Views.NoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 WindowStyle="None" ResizeMode="CanResize" MinWidth="200" MinHeight="160" ShowInTaskbar="False" WindowStartupLocation="Manual"
 Icon="/StickyNote;component/Assets/App.ico" Background="{Binding backgroundColor}" Foreground="{Binding foregroundColor}" Opacity="{Binding opacity}" Title="{Binding title}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#40000000" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid Background="#10000000" MouseLeftButtonDown="DragTitle">
   <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Button x:Name="AddButton" Content="+" Click="Add" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
   <Border Grid.Column="1" Background="Transparent" Cursor="SizeAll"><TextBlock Text="⋮" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Border>
   <TextBox x:Name="TitleBox" Grid.Column="2" Text="{Binding title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="3,0" Padding="3,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Foreground="{Binding foregroundColor}"/>
   <Button x:Name="MenuButton" Grid.Column="3" Content="⋯" Click="OpenMenu" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
   <Button x:Name="HideButton" Grid.Column="4" Content="×" Click="HideNote" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
  </Grid>
  <TextBox x:Name="Editor" Grid.Row="1" Text="{Binding content, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000000" FontSize="{Binding fontSize}" Foreground="{Binding foregroundColor}" Background="Transparent" BorderThickness="0" Padding="12,10" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left" FlowDirection="LeftToRight" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsUndoEnabled="True"/>
  <Grid Grid.Row="2" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Slider x:Name="OpacityGauge" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding opacity, StringFormat={}{0:P0}}"/>
   <Slider x:Name="FontGauge" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="8" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding fontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding fontSize, StringFormat={}{0:0} pt}"/>
  </Grid>
 </Grid></Border>
</Window>
