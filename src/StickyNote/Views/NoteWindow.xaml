<Window x:Class="StickyNote.Views.NoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 WindowStyle="None" ResizeMode="CanResize" MinWidth="200" MinHeight="160" ShowInTaskbar="True" WindowStartupLocation="Manual"
 Icon="/StickyNote;component/Assets/App.ico" Background="{Binding backgroundColor}" Foreground="{Binding foregroundColor}" Opacity="{Binding opacity}" Title="{Binding title}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#40000000" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="#10000000" MouseLeftButtonDown="DragTitle" Cursor="SizeAll">
   <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Button x:Name="AddButton" Content="+" Click="Add" Cursor="Arrow" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
   <TextBlock x:Name="TitleDisplay" Grid.Column="1" Text="{Binding title}" Focusable="True" KeyDown="EditTitleKeyDown" Margin="6,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding foregroundColor}"/>
   <TextBox x:Name="TitleBox" Grid.Column="1" Visibility="Collapsed" Cursor="IBeam" Text="{Binding title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="3,0" Padding="3,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Foreground="{Binding foregroundColor}"/>
   <Button x:Name="MenuButton" Grid.Column="2" Content="⋯" Click="OpenMenu" Cursor="Arrow" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
   <Button x:Name="DeleteButton" Grid.Column="3" Content="×" Click="DeleteNote" Cursor="Arrow" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"/>
  </Grid>
  <TextBox x:Name="Editor" Grid.Row="1" Text="{Binding content, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000000" FontFamily="{Binding fontFamily}" FontSize="{Binding fontSize}" Foreground="{Binding foregroundColor}" Background="Transparent" BorderThickness="0" Padding="12,10" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left" FlowDirection="LeftToRight" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsUndoEnabled="True"/>
  <Grid Grid.Row="2" Margin="10,3,10,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,6,0">
    <TextBlock FontSize="11"><Run x:Name="OpacityLabel"/><Run Text=" "/><Run Text="{Binding opacity, StringFormat={}{0:P0}, Mode=OneWay}"/></TextBlock>
    <Slider x:Name="OpacityGauge" Margin="0,4,0,0" Minimum="0.3" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="True" Value="{Binding opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding opacity, StringFormat={}{0:P0}}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="6,0,0,0">
    <TextBlock FontSize="11"><Run x:Name="FontLabel"/><Run Text=" "/><Run Text="{Binding fontSize, StringFormat={}{0:0}, Mode=OneWay}"/></TextBlock>
    <Slider x:Name="FontGauge" Margin="0,4,0,0" Minimum="8" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding fontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding fontSize, StringFormat={}{0:0} pt}"/>
   </StackPanel>
  </Grid>
 </Grid></Border>
</Window>
