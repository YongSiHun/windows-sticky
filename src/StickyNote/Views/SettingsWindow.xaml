<Window x:Class="StickyNote.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/StickyNote;component/Assets/App.ico" Width="460" Height="560" MinWidth="420" MinHeight="440" WindowStartupLocation="CenterScreen" Background="#F7F7F4">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
  <CheckBox x:Name="Startup" Margin="0,0,0,14"/>
  <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <TextBlock x:Name="BackgroundLabel"/>
  <Button x:Name="BackgroundButton" Click="BackgroundClick" Height="36" Margin="0,4,0,10"/>
  <TextBlock x:Name="ForegroundLabel"/>
  <Button x:Name="ForegroundButton" Click="ForegroundClick" Height="36" Margin="0,4,0,10"/>
  <TextBlock x:Name="FontFamilyLabel"/>
  <Button x:Name="FontFamilyButton" Click="FontFamilyClick" Height="36" Margin="0,4,0,10"/>
  <TextBlock x:Name="FontLabel"/><Slider x:Name="FontInput" Minimum="8" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" Margin="0,4,0,10"/>
  <TextBlock x:Name="OpacityLabel"/><Slider x:Name="OpacityInput" Minimum="0.3" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
  <TextBlock x:Name="ModeLabel"/><ComboBox x:Name="ModeChoice" Margin="0,4,0,10"/>
  <TextBlock x:Name="DefaultsHint" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,10"/>
  <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" Margin="0,8,0,2"/>
  <TextBlock x:Name="VersionValue" Margin="0,0,0,12"/>
  <WrapPanel><Button x:Name="UpdateButton" Click="CheckUpdatesClick"/><Button x:Name="DownloadsButton" Click="DownloadsClick" Visibility="Collapsed"/></WrapPanel>
  <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel><Button x:Name="ResetButton" Click="ResetClick"/><Button x:Name="ExportButton" Click="ExportClick"/><Button x:Name="RestoreButton" Click="RestoreClick"/><Button x:Name="SaveButton" Click="SaveClick" IsDefault="True"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
